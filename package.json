{
  "name": "lerium",
  "version": "0.2.0",
  "private": true,
  "description": "Extensão do Chrome que traduz páginas e seleções com modelos locais do Ollama.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "build": "vite build && vite build -c vite.content.config.ts && node scripts/verify-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.integration.json",
    "test": "vitest run",
    "test:manual": "vitest run --config vitest.manual.config.ts",
    "lint": "eslint . && prettier --check \"**/*.{ts,js,mjs,json,html,css}\"",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,html,css}\"",
    "icons": "node scripts/generate-icons.mjs",
    "extension-id": "node scripts/extension-id.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
